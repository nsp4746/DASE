GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Optional: your account's hosted prompt for the existing OpenAI integration.
# OPENAI_PROMPT_ID=pmpt_...

# Local MLX-LM server. DASE never falls back to a cloud provider.
MLX_BASE_URL=http://127.0.0.1:8080/v1
MLX_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit
MLX_TIMEOUT=120
MLX_MAX_TOKENS=768
MLX_TEMPERATURE=0.7
MLX_TOP_P=0.8
# Character guard, not a tokenizer-based context limit; includes system prompt.
MLX_MAX_HISTORY_CHARS=24000
